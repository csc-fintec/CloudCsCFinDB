Project CsCFinDB_schema {
    database_type: 'PostgresSQL'
    Note: 'This is my database schema for modeling my personal finance data'
}

enum TransactionType { //The type of the money that was used
  REFUND
  INCOME
  EXPENSE
  PENALTY
  TRANSFER
  UNCLASSIFIED
}

enum MoneyType { //The type of the money that was used
  CASH
  CHECK 
  DEBIT 
  CCARD
  UNKNOWN
}

enum VendorType { //The type of the vendor
  BANK
  GOVERNMENT
  MERCHANT
  INSURANCE
  GENERIC
}

Table categories {
    id integer [pk,unique,not null,increment]
    name varchar(100) [not null, unique]
    description varchar(255)
}

TablePartial address_base {
    Address1 varchar(255) [not null]
    Address2 varchar(255) [not null]
    City varchar(100) [not null]
    State varchar(100) [not null]
    ZipCode varchar(20) [not null]
}


Table money_adresses {
    id integer [pk,unique,not null,increment]
    ~address_base
}

//Money instruments are the different ways that money can be used to pay for things.
Table money_instruments {
    id integer [pk, unique, not null, increment]

    name varchar(100)

    type MoneyType

    account_no   integer [not null]
    account_desc varchar(100) [not null]
    institution  varchar(100) [not null]

    description      varchar(255) [null]
    full_description varchar(255) [null]

    interest_rate integer [null] //Only if this is a credit card
    expiration_date date [null]  ///Only if this is a credit card 

    addr_id integer [ref: > money_adresses.id] 
}


//---------------------------------------------------------
Table vendor_adresses {
    id integer [pk,unique,not null,increment]
    ~address_base
}

Table vendors {
    id integer [pk, unique, not null, increment]
    name varchar(100)

    //The name of the business that is associated with this vendor.
    //This is not the same as the name of the vendor itself. 
    //For example, the vendor might be "Amazon" but the business name might be "Amazon.com, Inc."
    business_name varchar(100) [null]

    type VendorType

    //These are what the headers of the tiller spreadsheet are called.
    //They are not the same as the column names in the vendors table
    shrt_desc varchar(255) [null]
    full_desc varchar(255) [null]

    website varchar(255) [null]

    addr_id integer [ref: > vendor_adresses.id] //The providor of the service involved in the transaction 
}
//---------------------------------------------------------

Table transactions {
    id integer [pk, unique, not null, increment]

    date date

    amount decimal
    product varchar(255)

    type TransactionType

    description varchar(255)
    full_description varchar(255)
    
    categ_id integer [ref: > categories.id]  //The category of the transaction
    money_id integer [ref: > money_instruments.id] //The monetary instrument used
    vendr_id integer [ref: > vendors.id] //The providor of the service involved in the transacion
}
Project CsCFinDB_schema {
    database_type: 'PostgresSQL'
    Note: 'This is my database schema for modeling my personal finance data'
}

enum TransactTypes { //The type of the transaction that was performed
  TAXES
  REFUND
  INCOME
  EXPENSE
  PENALTY
  TRANSFER
  UNKNOWN
}

enum PaymentTypes { //The type of payment that was used
  CHECK 
  DEBIT 
  CREDIT
}

enum FinancialTypes { //The type financial instiutions that provided the funds
  BANK
  CCARD
  BROKER
  UNKNOWN
}

// BANK
// BROKER

enum VendorTypes { //The type of the vendor
  MERCHANT
  INSURANCE
  GOVERNMENT
  GENERAL
}

TablePartial address_base {
    address  varchar(255)
    city     varchar(255)
    state    varchar(2) 
    zipcode  varchar(5)
    country  varchar(20)
    phoneno  varchar(20)
}

Table categories {
    id integer [pk,unique,not null,increment]
    name varchar(100) [not null, unique]
    description varchar(255)
}

Table financial_addresses {
    id bigint [pk,unique,not null]
    location_name varchar(100) [null]
    ~address_base
}

//Financial instruments are the different ways 
//that money can be used to pay for things.
Table financial_instruments {
    id bigint [pk, unique, not null]

    type FinancialTypes

    //name         varchar(100)
    institution  varchar(100) [null]
    accnumb_abrv varchar(20)  [null]
    account_desc varchar(100) [null]


    routing_numb varchar(20) [null]  //If this is a bank account
    account_numb varchar(20) [null]

    balance         numeric(5,4) [null]
    interest_rate   numeric(5,4) [null] //Only if this is a credit card
    expiration_date date         [null]  ///Only if this is a credit card 

    addr_id bigint [ref: > financial_addresses.id] 
}


//---------------------------------------------------------
Table vendor_addresses {
    id bigint [pk,unique,not null]
    business_name varchar(100) [null]
    ~address_base
}

Table vendors {
    id bigint [pk, unique, not null]

    type VendorTypes //The classification of the vendor,

    //The name of the business that is associated with this vendor.
    //This is not the same as the name of the vendor itself. 
    //For example, the vendor might be "Amazon" but the business name might be "Amazon.com, Inc."
    business_name varchar(100) [null]

    //These are what the headers of the tiller spreadsheet are called.
    //They are not the same as the column names in the vendors table
    shrt_desc varchar(255) [null]
    full_desc varchar(512) [null]

    website varchar(255)   [null]

    addr_id bigint [ref: > vendor_addresses.id] //The providor of the service involved in the transaction 
}
//---------------------------------------------------------

Table transactions {
    id bigint [pk, unique, not null]

    date date

    amount  numeric(5,4) [null]

    product varchar(255) [null]

    ptype PaymentTypes
    ttype TransactTypes

    shrt_desc varchar(255)
    full_desc varchar(512)
    
    categ_id bigint [ref: > categories.id]  //The category of the transaction
    vendr_id bigint [ref: > vendors.id] //The providor of the service involved in the transacion
    money_id bigint [ref: > financial_instruments.id] //The monetary instrument used
}
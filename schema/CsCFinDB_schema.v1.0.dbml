Project CsCFinDB_schema {
    database_type: 'PostgresSQL'
    Note: 'This is my database schema for modeling my personal finance data'
}

enum TransactTypes { //The type of the transaction that was performed
  REFUND
  INCOME
  EXPENSE
  PENALTY
  TRANSFER
  UNCLASSIFIED
}

enum FinancialTypes { //The type of the money that was used
  CASH
  CHECK 
  DEBIT 
  CCARD
  UNKNOWN
}

enum VendorTypes { //The type of the vendor
  BANK
  BROKER
  MERCHANT
  INSURANCE
  GOVERNMENT
  GENERAL
}

Table categories {
    id integer [pk,unique,not null,increment]
    name varchar(100) [not null, unique]
    description varchar(255)
}

TablePartial address_base {
    Address1 varchar(255)
    Address2 varchar(255)
    City varchar(100)
    State varchar(100) 
    ZipCode varchar(20)
}


Table financial_addresses {
    id integer [pk,unique,not null,increment]
    ~address_base
}

//Financial instruments are the different ways that money can be used to pay for things.
Table financials {
    id integer [pk, unique, not null, increment]

    name varchar(100)

    type FinancialTypes

    routing_numb integer      [null]  //If this is a bank account
    account_desc varchar(100) [null]
    account_numb integer      [not null]
    accnumb_abrv varchar(100) [null]
    institution  varchar(100) [not null]

    //#description      varchar(255) [null]
    //#full_description varchar(255) [null]

    interest_rate integer [null] //Only if this is a credit card
    expiration_date date  [null]  ///Only if this is a credit card 

    addr_id integer [ref: > financial_addresses.id] 
}


//---------------------------------------------------------
Table vendor_addresses {
    id bigint [pk,unique,not null]
    business_name varchar(100) [null]
    ~address_base
}

Table vendors {
    id bigint [pk, unique, not null, increment]
    name varchar(100)

    //The name of the business that is associated with this vendor.
    //This is not the same as the name of the vendor itself. 
    //For example, the vendor might be "Amazon" but the business name might be "Amazon.com, Inc."
    business_name varchar(100) [null]

    type VendorTypes

    //These are what the headers of the tiller spreadsheet are called.
    //They are not the same as the column names in the vendors table
    shrt_desc varchar(255) [null]
    full_desc varchar(255) [null]

    website varchar(255) [null]

    addr_id bigint [ref: > vendor_addresses.id] //The providor of the service involved in the transaction 
}
//---------------------------------------------------------

Table transactions {
    id integer [pk, unique, not null, increment]

    date date

    amount decimal
    product varchar(255)

    type TransactTypes

    description varchar(255)
    full_description varchar(255)
    
    categ_id integer [ref: > categories.id]  //The category of the transaction
    money_id integer [ref: > financials.id] //The monetary instrument used
    vendr_id integer [ref: > vendors.id] //The providor of the service involved in the transacion
}